services:
  client:
    image: '${DOCKER_USERNAME:-rallycoding}/multi-client'
    mem_limit: 128m
    hostname: client
  server:
    image: '${DOCKER_USERNAME:-rallycoding}/multi-server'
    mem_limit: 128m
    hostname: api
    environment:
      - REDIS_HOST=${REDIS_HOST:-redis}
      - REDIS_PORT=${REDIS_PORT:-6379}
      - PGUSER=${PGUSER:-postgres}
      - PGHOST=${PGHOST:-postgres}
      - PGDATABASE=${PGDATABASE:-postgres
      - PGPASSWORD=${PGPASSWORD:-postgrespassword}
      - PGPORT=${PGPORT:-5432}
  worker:
    image: '${DOCKER_USERNAME:-rallycoding}/multi-worker'
    mem_limit: 128m
    hostname: worker
    environment:
      - REDIS_HOST=${REDIS_HOST:-redis}
      - REDIS_PORT=${REDIS_PORT:-6379}
  nginx:
    image: '${DOCKER_USERNAME:-rallycoding}/multi-nginx'
    mem_limit: 128m
    hostname: nginx
    ports:
      - '80:80'
